# ----------------------------------------------------------------------
# A. SEGURANÇA MÁXIMA (HEADERS FORENSES)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    # Previne Clickjacking (Não permite que o site seja aberto num iframe)
    Header set X-Frame-Options "DENY"

    # Previne ataques XSS (Cross-Site Scripting)
    Header set X-XSS-Protection "1; mode=block"

    # Impede o navegador de tentar adivinhar o tipo do arquivo (MIME-sniffing)
    Header set X-Content-Type-Options "nosniff"

    # HSTS - Força conexão HTTPS por 1 ano, incluindo subdomínios
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # CSP - Upgrade automático para HTTPS e bloqueio de iframes externos
    Header set Content-Security-Policy "upgrade-insecure-requests; frame-ancestors 'none';"

    # Referrer Policy - Protege dados de URL ao sair do site
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy - Desativa recursos não utilizados (GPS, Câmera, etc)
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>

# ----------------------------------------------------------------------
# B. PERFORMANCE E CACHE AGRESSIVO (BROWSER CACHING)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Imagens e Vídeos - Cache por 1 ano (imutáveis)
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    
    # CSS e JS - Cache por 1 ano (o Vite altera o nome do arquivo se ele mudar)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    
    # Fontes - Cache por 1 ano
    ExpiresByType font/woff2 "access plus 1 year"
    
    # HTML - Sem cache (Sempre validar)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ----------------------------------------------------------------------
# C. COMPRESSÃO GZIP / BROTLI
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# D. ROTEAMENTO DO REACT (SPA FALLBACK)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
